{
  "name": "tuition-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @tuition/web",
    "dev:api": "npm run dev -w @tuition/api",
    "build:web": "npm run build -w @tuition/web",
    "build:api": "npm run build -w @tuition/api",
    "start:api": "npm run start -w @tuition/api",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @tuition/api\" \"npm run dev -w @tuition/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @tuition/api",
    "verify": "npm run typecheck && npm test && npm run build",
    "bootstrap": "npm run bootstrap -w @tuition/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
