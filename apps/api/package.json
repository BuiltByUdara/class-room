{
  "name": "@tuition/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "bootstrap:hosted": "tsx src/scripts/bootstrap.ts",
