NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Use strict for localhost or HTTPS subdomains of the same domain.
# Different sites require none and production HTTPS; see docs/operations.md.
COOKIE_SAME_SITE=strict
TRUST_PROXY_HOPS=0
# Phase 2 requires transactions: use a replica set or managed MongoDB cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/tuition?replicaSet=rs0
SESSION_HOURS=12
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tuition <noreply@localhost>
# Set these only while running npm run bootstrap; remove afterward.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
